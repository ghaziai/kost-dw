# Salin ke .env lalu sesuaikan. Dibaca oleh server (node --env-file) dan ETL (run_etl.py).
PORT=3000

# --- Opsi A: Supabase (proyek "Kost", org AIHO GROUP, ref fooxsvwnaqbfnnqpokht) ---
# OLTP (skema public) dan DW (skema dw/stg/etl) berada di SATU database, jadi kedua URL sama.
# Pakai Session pooler (IPv4). Host langsung db.<ref>.supabase.co hanya IPv6 sehingga sering gagal di jaringan rumah.
# Ganti [DB-PASSWORD] dengan password database (Dashboard > Settings > Database > Reset database password).
# Bila password memuat karakter khusus (@ : / ? # %), encode dulu (mis. @ -> %40).
OLTP_DATABASE_URL=postgresql://postgres.fooxsvwnaqbfnnqpokht:[DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DW_DATABASE_URL=postgresql://postgres.fooxsvwnaqbfnnqpokht:[DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Opsi B: PostgreSQL lokal (dua database terpisah; lihat scripts/demo.sh) ---
# OLTP_DATABASE_URL=postgresql:///kost_oltp
# DW_DATABASE_URL=postgresql:///kost_dw

# Ganti dengan string acak panjang (mis. `openssl rand -hex 32`)
TOKEN_SECRET=ganti-secret-ini-sebelum-dipakai
# Opsional: paksa "hari ini" aplikasi untuk demo/simulasi (YYYY-MM-DD). Kosongkan untuk tanggal sebenarnya.
APP_TODAY=2026-11-12

# Info proyek Supabase (untuk pengembangan lanjutan: supabase-js / Next.js). Kunci publishable boleh di sisi klien.
SUPABASE_URL=https://fooxsvwnaqbfnnqpokht.supabase.co
